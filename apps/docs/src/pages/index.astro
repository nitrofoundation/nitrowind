---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";

const frontmatter = {
  title: "React Native Tailwind CSS",
  description:
    "Nitrowind brings Tailwind CSS v4 to React Native with a native C++ engine, adaptive themes, container queries, safe-area utilities, and component interop.",
  template: "splash" as const,
  editUrl:
    "https://github.com/nitrofoundation/nitrowind/edit/main/apps/docs/src/pages/index.astro",
};
---

<StarlightPage {frontmatter}>
  <main class="docs-home">
    <section class="docs-home__hero" aria-labelledby="home-title">
      <p class="docs-home__eyebrow">Tailwind CSS v4 for React Native</p>
      <p class="docs-home__title" id="home-title">Native-speed styling with the workflow you already know.</p>
      <p class="docs-home__lead">
        Nitrowind compiles Tailwind classes into React Native styles and updates
        runtime state through a native C++ ShadowTree engine. Build responsive,
        theme-aware interfaces without putting React back on the render path.
      </p>
      <div class="docs-home__actions">
        <a class="docs-home__primary" href="/getting-started/installation/">Get started</a>
        <a href="/getting-started/migration/">Migrate from NativeWind or Uniwind</a>
      </div>
    </section>

    <section class="docs-home__grid" aria-label="Documentation highlights">
      <a href="/getting-started/installation/">
        <span>Start here</span>
        <strong>Installation</strong>
        <p>Install Nitrowind, configure Metro, and render your first className.</p>
      </a>
      <a href="/core-concepts/theming/">
        <span>Core concept</span>
        <strong>Adaptive theming</strong>
        <p>Use light, dark, system, and named themes without React re-renders.</p>
      </a>
      <a href="/features/container-queries/">
        <span>Layout</span>
        <strong>Container queries</strong>
        <p>Adapt components to the measured width and height of their container.</p>
      </a>
      <a href="/features/background-images/">
        <span>Native visuals</span>
        <strong>Background images</strong>
        <p>Use cover, contain, stretch, repeat, positioning, and native descriptors.</p>
      </a>
      <a href="/api/runtime/">
        <span>Reference</span>
        <strong>Runtime API</strong>
        <p>Explore providers, hooks, style registration, snapshots, and helpers.</p>
      </a>
      <a href="/skills/">
        <span>AI agents</span>
        <strong>Nitrowind skills</strong>
        <p>Install focused project skills for setup, styling, and native workflows.</p>
      </a>
    </section>

    <section class="docs-home__summary" aria-labelledby="why-nitrowind">
      <div>
        <p class="docs-home__eyebrow">Built for real React Native apps</p>
        <h2 id="why-nitrowind">One styling system across native runtime states.</h2>
      </div>
      <ul>
        <li>Tailwind CSS v4 utilities through <code>className</code></li>
        <li>iOS, Android, web, native, macOS, and Windows variants</li>
        <li>Safe-area utilities, interaction states, SVG, and third-party interop</li>
        <li>Plain CSS support through the lower-level <code>nitrocss</code> package</li>
      </ul>
    </section>
  </main>
</StarlightPage>
