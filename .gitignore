.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.yarn/cache
.yarn/install-state.gz

# Build outputs
dist/
lib/
!apps/docs/lib/
!apps/docs/lib/**
build/
.astro/
*.tsbuildinfo

# Nitro / native generated
nitrogen/generated/
packages/*/nitrogen/generated/

# Native
ios/Pods/
ios/build/
ios/*.xcworkspace/xcuserdata/
android/.gradle/
android/.cxx/
android/build/
**/android/.gradle/
**/android/.cxx/
**/android/**/.cxx/
**/android/build/
**/android/app/build/
*.keystore

# Metro / Expo
.expo/
.expo-shared/
web-build/

