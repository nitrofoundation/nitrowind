# Dependencies
node_modules/
.pnp.*

# Yarn Berry (node-modules linker): ignore caches/state, keep tooling + yarn.lock
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.yarn/cache
.yarn/install-state.gz

# Build outputs
dist/
lib/
build/
*.tsbuildinfo

# Nitro / native generated
nitrogen/generated/
packages/*/nitrogen/generated/

# Native
ios/Pods/
ios/build/
ios/*.xcworkspace/xcuserdata/
android/.gradle/
android/.cxx/
android/build/
**/android/.gradle/
**/android/.cxx/
**/android/**/.cxx/
**/android/build/
**/android/app/build/
*.keystore

# Metro / Expo
.expo/
.expo-shared/
web-build/

# Misc
.DS_Store
*.log
.turbo/
coverage/
.env*.local
# Vendored by Nitrowind.podspec at pod-install time (copied from packages/nitrocss/cpp)
packages/nitrowind/cpp/nitrocss/

# Android SDK location (machine-specific)
local.properties
