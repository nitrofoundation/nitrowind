{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["nitrocss"],
  "ios": {
    "iosModuleName": "NitroCss"
  },
  "android": {
    "androidNamespace": ["nitrocss"],
    "androidCxxLibName": "NitroCss"
  },
  "autolinking": {
    "NitroCssConfig": {
      "cpp": "HybridNitroCssConfig"
    },
    "NitroCssRuntime": {
      "cpp": "HybridNitroCssRuntime"
    },
    "ShadowRegistry": {
      "cpp": "HybridShadowRegistry"
    },
    "ShadowNodeHandle": {
      "cpp": "HybridShadowNodeHandle"
    },
    "FollyStyle": {
      "cpp": "HybridFollyStyle"
    },
    "NitroCssDiagnostics": {
      "cpp": "HybridNitroCssDiagnostics"
    },
    "NativePlatform": {
      "swift": "HybridNativePlatform",
      "kotlin": "HybridNativePlatform"
    },
    "BackdropView": {
      "swift": "HybridBackdropView",
      "kotlin": "HybridBackdropView"
    }
  },
  "ignorePaths": ["node_modules", "lib", "example"]
}
