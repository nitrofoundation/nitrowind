{
  "name": "@nitrofoundation/nitrocss",
  "version": "0.2.0-beta.2",
  "description": "Core native CSS engine for React Native — compiles plain CSS to native styles and commits them through a C++ ShadowTree engine.",
  "license": "MIT",
  "author": "NitroFoundation contributors",
  "repository": "https://github.com/nitrofoundation/nitrocss",
  "homepage": "https://github.com/nitrofoundation/nitrocss",
  "type": "module",
  "source": "./src/index.ts",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/commonjs/index.d.ts",
  "react-native": "./src/index.ts",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./lib/typescript/commonjs/index.d.ts",
      "style": "./safe-area.css",
      "source": "./src/index.ts",
      "react-native": "./src/index.ts",
      "import": "./lib/module/index.js",
      "require": "./lib/commonjs/index.js"
    },
    "./components": {
      "source": "./src/components/index.ts",
      "react-native": "./src/components/index.ts",
      "import": {
        "types": "./lib/typescript/module/components/index.d.ts",
        "default": "./lib/module/components/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/components/index.d.ts",
        "default": "./lib/commonjs/components/index.js"
      }
    },
    "./svg": {
      "source": "./src/svg/index.tsx",
      "react-native": "./src/svg/index.tsx",
      "import": {
        "types": "./lib/typescript/module/svg/index.d.ts",
        "default": "./lib/module/svg/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/svg/index.d.ts",
        "default": "./lib/commonjs/svg/index.js"
      }
    },
    "./compiler": {
      "source": "./src/compiler/index.ts",
      "react-native": "./src/compiler/index.ts",
      "import": {
        "types": "./lib/typescript/module/compiler/index.d.ts",
        "default": "./lib/module/compiler/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/compiler/index.d.ts",
        "default": "./lib/commonjs/compiler/index.js"
      }
    },
    "./compiler/parsers": {
      "source": "./src/compiler/parsers/index.ts",
      "react-native": "./src/compiler/parsers/index.ts",
      "import": {
        "types": "./lib/typescript/module/compiler/parsers/index.d.ts",
        "default": "./lib/module/compiler/parsers/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/compiler/parsers/index.d.ts",
        "default": "./lib/commonjs/compiler/parsers/index.js"
      }
    },
    "./compiler/parsers/*": {
      "source": "./src/compiler/parsers/*.ts",
      "react-native": "./src/compiler/parsers/*.ts",
      "import": {
        "types": "./lib/typescript/module/compiler/parsers/*.d.ts",
        "default": "./lib/module/compiler/parsers/*.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/compiler/parsers/*.d.ts",
        "default": "./lib/commonjs/compiler/parsers/*.js"
      }
    },
    "./compiler/*": {
      "source": "./src/compiler/*.ts",
      "react-native": "./src/compiler/*.ts",
      "import": {
        "types": "./lib/typescript/module/compiler/*.d.ts",
        "default": "./lib/module/compiler/*.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/compiler/*.d.ts",
        "default": "./lib/commonjs/compiler/*.js"
      }
    },
    "./inspector": {
      "source": "./src/inspector/index.ts",
      "react-native": "./src/inspector/index.ts",
      "import": {
        "types": "./lib/typescript/module/inspector/index.d.ts",
        "default": "./lib/module/inspector/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/inspector/index.d.ts",
        "default": "./lib/commonjs/inspector/index.js"
      }
    },
    "./accessibility": {
      "source": "./src/accessibility/index.ts",
      "react-native": "./src/accessibility/index.ts",
      "import": {
        "types": "./lib/typescript/module/accessibility/index.d.ts",
        "default": "./lib/module/accessibility/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/accessibility/index.d.ts",
        "default": "./lib/commonjs/accessibility/index.js"
      }
    },
    "./metro": {
      "source": "./src/metro/index.ts",
      "types": "./lib/typescript/commonjs/metro/index.d.ts",
      "default": "./lib/commonjs/metro/index.js"
    },
    "./metro/transformer": {
      "source": "./src/metro/transformer.ts",
      "default": "./lib/commonjs/metro/transformer.js"
    },
    "./metro/pipeline": {
      "source": "./src/metro/pipeline.ts",
      "default": "./lib/commonjs/metro/pipeline.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "safe-area.css",
    "cpp",
    "apple",
    "ios",
    "macos",
    "android",
    "!android/.cxx",
    "!android/build",
    "!android/.DS_Store",
    "nitrogen/generated",
    "nitro.json",
    "NitroCss.podspec",
    "react-native.config.cjs",
    "README.md",
    "LICENSE",
    "!**/__tests__",
    "!**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "nitrogen": "nitrogen",
    "build": "bob build",
    "prepack": "yarn nitrogen && yarn build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint src",
    "clean": "rimraf lib nitrogen/generated"
  },
  "dependencies": {
    "culori": "4.0.2",
    "lightningcss": "1.32.0"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-native": "0.81.6 || >=0.85.0",
    "react-native-nitro-modules": ">=0.35.0",
    "react-native-reanimated": ">=3.0.0",
    "react-native-svg": ">=15.0.0"
  },
  "peerDependenciesMeta": {
    "react-native-reanimated": {
      "optional": true
    },
    "react-native-svg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/culori": "2.1.1",
    "@types/node": "^22.12.0",
    "@types/react": "19.2.17",
    "nitrogen": "0.35.9",
    "react": "19.2.3",
    "react-native": "patch:react-native@npm%3A0.86.0#~/.yarn/patches/react-native-npm-0.86.0-da5f3ab36a.patch",
    "react-native-builder-bob": "0.40.13",
    "react-native-nitro-modules": "0.35.9",
    "rimraf": "6.0.1",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  },
  "codegenConfig": {
    "name": "TurboNitroCss",
    "type": "modules",
    "jsSrcsDir": "./src/specs"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      "typescript"
    ]
  },
  "keywords": [
    "react-native",
    "css",
    "native",
    "cpp",
    "nitro",
    "nitro-modules",
    "fabric",
    "shadowtree",
    "styling",
    "theme"
  ]
}
