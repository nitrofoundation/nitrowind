{
  "name": "@nitrofoundation/nitrowind",
  "version": "0.2.0-beta.2",
  "description": "The fastest Tailwind bindings for React Native — a thin Tailwind CSS wrapper around nitrocss, the fully open-source native C++ ShadowTree styling engine.",
  "license": "MIT",
  "author": "Nitrowind contributors",
  "repository": "https://github.com/nitrowind/nitrowind",
  "homepage": "https://github.com/nitrowind/nitrowind",
  "type": "module",
  "source": "./src/index.ts",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/commonjs/index.d.ts",
  "react-native": "./src/index.ts",
  "bin": "./bin/nitrowind.mjs",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "react-native": "./src/index.ts",
      "import": {
        "types": "./lib/typescript/module/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./components": {
      "source": "./src/components/index.ts",
      "react-native": "./src/components/index.ts",
      "import": {
        "types": "./lib/typescript/module/components/index.d.ts",
        "default": "./lib/module/components/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/components/index.d.ts",
        "default": "./lib/commonjs/components/index.js"
      }
    },
    "./compiler": {
      "source": "./src/compiler/index.ts",
      "react-native": "./src/compiler/index.ts",
      "import": {
        "types": "./lib/typescript/module/compiler/index.d.ts",
        "default": "./lib/module/compiler/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/compiler/index.d.ts",
        "default": "./lib/commonjs/compiler/index.js"
      }
    },
    "./svg": {
      "source": "./src/svg/index.ts",
      "react-native": "./src/svg/index.ts",
      "import": {
        "types": "./lib/typescript/module/svg/index.d.ts",
        "default": "./lib/module/svg/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/svg/index.d.ts",
        "default": "./lib/commonjs/svg/index.js"
      }
    },
    "./metro": {
      "source": "./src/metro/index.ts",
      "types": "./lib/typescript/commonjs/metro/index.d.ts",
      "default": "./lib/commonjs/metro/index.js"
    },
    "./metro/pipeline": {
      "source": "./src/metro/pipeline.ts",
      "types": "./lib/typescript/commonjs/metro/pipeline.d.ts",
      "default": "./lib/commonjs/metro/pipeline.js"
    },
    "./presets": {
      "source": "./src/presets/index.ts",
      "react-native": "./src/presets/index.ts",
      "import": {
        "types": "./lib/typescript/module/presets/index.d.ts",
        "default": "./lib/module/presets/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/presets/index.d.ts",
        "default": "./lib/commonjs/presets/index.js"
      }
    },
    "./tooling": {
      "source": "./src/tooling/index.ts",
      "import": {
        "types": "./lib/typescript/module/tooling/index.d.ts",
        "default": "./lib/module/tooling/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/tooling/index.d.ts",
        "default": "./lib/commonjs/tooling/index.js"
      }
    },
    "./inspector": {
      "source": "./src/inspector/index.ts",
      "react-native": "./src/inspector/index.ts",
      "import": {
        "types": "./lib/typescript/module/inspector/index.d.ts",
        "default": "./lib/module/inspector/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/inspector/index.d.ts",
        "default": "./lib/commonjs/inspector/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "bin",
    "lib",
    "README.md",
    "LICENSE",
    "!**/__tests__",
    "!**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "bob build",
    "prepack": "yarn build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint src",
    "clean": "rimraf lib"
  },
  "dependencies": {
    "@tailwindcss/node": "4.3.1",
    "@tailwindcss/oxide": "4.3.1"
  },
  "peerDependencies": {
    "@nitrofoundation/nitrocss": "*",
    "react": ">=19.0.0",
    "react-native": "0.81.6 || >=0.85.0",
    "react-native-nitro-modules": ">=0.35.0",
    "react-native-svg": ">=15.0.0",
    "tailwindcss": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "react-native-reanimated": {
      "optional": true
    },
    "react-native-svg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nitrofoundation/nitrocss": "workspace:*",
    "@types/node": "^22.12.0",
    "@types/react": "19.2.17",
    "react": "19.2.3",
    "react-native": "patch:react-native@npm%3A0.86.0#~/.yarn/patches/react-native-npm-0.86.0-da5f3ab36a.patch",
    "react-native-builder-bob": "0.40.13",
    "rimraf": "6.0.1",
    "tailwindcss": "4.3.1",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      "typescript"
    ]
  },
  "keywords": [
    "react-native",
    "tailwind",
    "tailwindcss",
    "nitro",
    "nitro-modules",
    "fabric",
    "shadowtree",
    "styling",
    "theme"
  ]
}
