{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["nitrowind"],
  "ios": {
    "iosModuleName": "Nitrowind"
  },
  "android": {
    "androidNamespace": ["nitrowind"],
    "androidCxxLibName": "Nitrowind"
  },
  "autolinking": {
    "NitrowindConfig": {
      "cpp": "HybridNitrowindConfig"
    },
    "NitrowindRuntime": {
      "cpp": "HybridNitrowindRuntime"
    },
    "ShadowRegistry": {
      "cpp": "HybridShadowRegistry"
    },
    "ShadowNodeHandle": {
      "cpp": "HybridShadowNodeHandle"
    },
    "FollyStyle": {
      "cpp": "HybridFollyStyle"
    },
    "NitrowindDiagnostics": {
      "cpp": "HybridNitrowindDiagnostics"
    },
    "NativePlatform": {
      "swift": "HybridNativePlatform",
      "kotlin": "HybridNativePlatform"
    },
    "GradientView": {
      "swift": "HybridGradientView",
      "kotlin": "HybridGradientView"
    },
    "GradientRegistry": {
      "cpp": "HybridGradientRegistry"
    }
  },
  "ignorePaths": ["node_modules", "lib", "example"]
}
