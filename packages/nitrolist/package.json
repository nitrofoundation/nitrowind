{
  "name": "nitrolist",
  "version": "0.1.0",
  "description": "Native-first virtual list primitives for React Native powered by a C++ Nitro engine.",
  "license": "MIT",
  "author": "Nitrolist contributors",
  "repository": "https://github.com/nitrowind/nitrowind",
  "homepage": "https://github.com/nitrowind/nitrowind",
  "type": "module",
  "source": "./src/index.ts",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/commonjs/index.d.ts",
  "react-native": "./src/index.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "react-native": "./src/index.ts",
      "import": {
        "types": "./lib/typescript/module/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "cpp",
    "ios",
    "android",
    "nitrogen/generated",
    "nitro.json",
    "Nitrolist.podspec",
    "react-native.config.js",
    "!**/__tests__",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "nitrogen": "nitrogen",
    "build": "bob build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint src",
    "clean": "rimraf lib nitrogen/generated"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-native": ">=0.85.0",
    "react-native-nitro-modules": ">=0.35.0"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "@types/react": "19.2.17",
    "nitrogen": "0.35.9",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-builder-bob": "0.40.13",
    "react-native-nitro-modules": "0.35.9",
    "rimraf": "6.0.1",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  },
  "codegenConfig": {
    "name": "TurboNitrolist",
    "type": "modules",
    "jsSrcsDir": "./src/specs"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      "typescript"
    ]
  },
  "keywords": [
    "react-native",
    "virtual-list",
    "virtualization",
    "nitro",
    "nitro-modules",
    "fabric",
    "lazy-stack"
  ]
}
