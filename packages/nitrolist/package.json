{
  "name": "@nitrofoundation/nitrolist",
  "version": "0.1.0",
  "description": "Native-engine list virtualization for React Native — three isolated, differently-named list variants (Virtual / Valdi / Lynx) over React-owned cells.",
  "license": "MIT",
  "author": "NitroFoundation contributors",
  "repository": "https://github.com/nitrofoundation/nitrolist",
  "type": "module",
  "source": "./src/index.ts",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/commonjs/index.d.ts",
  "react-native": "./src/index.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./src/index.ts",
      "react-native": "./src/index.ts",
      "import": {
        "types": "./lib/typescript/module/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./components": {
      "source": "./src/components/index.ts",
      "react-native": "./src/components/index.ts",
      "import": {
        "types": "./lib/typescript/module/components/index.d.ts",
        "default": "./lib/module/components/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/components/index.d.ts",
        "default": "./lib/commonjs/components/index.js"
      }
    }
  },
  "files": [
    "src",
    "lib",
    "cpp",
    "README.md",
    "LICENSE",
    "!**/__tests__",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "bob build",
    "typecheck": "tsc --noEmit",
    "clean": "del-cli lib"
  },
  "peerDependencies": {
    "@nitrofoundation/nitrocss": "*",
    "react": ">=19.0.0",
    "react-native": ">=0.85.0"
  },
  "devDependencies": {
    "react": "19.1.0",
    "react-native": "0.86.0",
    "react-native-builder-bob": "^0.40.13",
    "typescript": "^5.7.3"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      "typescript"
    ]
  }
}
