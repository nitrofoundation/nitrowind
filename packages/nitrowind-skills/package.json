{
  "name": "@nitrofoundation/nitrowind-skills",
  "version": "0.2.0-beta.3",
  "description": "Curated agent skills and an interactive generator for Nitrowind projects.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nitrofoundation/nitrowind.git",
    "directory": "packages/nitrowind-skills"
  },
  "homepage": "https://nitrowind.dev/",
  "bugs": {
    "url": "https://github.com/nitrofoundation/nitrowind/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": "dist/cli.js",
  "files": [
    "dist",
    "skills",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "yarn generate:skills",
    "typecheck": "tsc --noEmit",
    "generate:skills": "yarn build && node dist/generate.js ."
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "typescript": "5.9.2"
  },
  "keywords": [
    "nitrowind",
    "nitro-css",
    "skills",
    "agents",
    "react-native",
    "tailwindcss"
  ]
}
