{
  "name": "nitrowind-monorepo",
  "version": "1.0.0-beta.0",
  "private": true,
  "description": "Nitrowind — fully open-source, fastest Tailwind bindings for React Native (native C++ ShadowTree engine, free for everyone)",
  "license": "MIT",
  "homepage": "https://nitrowind.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nitrofoundation/nitrowind.git"
  },
  "bugs": {
    "url": "https://github.com/nitrofoundation/nitrowind/issues"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "resolutions": {
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-native": "0.86.0",
    "cookie": "^2.0.1"
  },
  "scripts": {
    "build": "turbo run build",
    "docs": "yarn workspace docs dev",
    "docs:build": "yarn workspace docs build",
    "docs:deploy": "bash scripts/deploy-docs.sh",
    "x:link": "node scripts/x-link.mjs",
    "release": "release-it",
    "release:dry-run": "release-it --dry-run",
    "typecheck": "turbo run typecheck",
    "typecheck:packages": "turbo run typecheck --filter=@nitrofoundation/nitrocss --filter=@nitrofoundation/nitrowind --filter=@nitrofoundation/nitrowind-skills",
    "test": "turbo run test",
    "test:packages": "turbo run test --filter=@nitrofoundation/nitrocss --filter=@nitrofoundation/nitrowind",
    "lint": "turbo run lint",
    "dev": "turbo run dev",
    "build:packages": "turbo run build --filter=@nitrofoundation/nitrocss --filter=@nitrofoundation/nitrowind --filter=@nitrofoundation/nitrowind-skills",
    "nitrogen": "turbo run nitrogen",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@release-it-plugins/workspaces": "5.0.3",
    "release-it": "19.2.4",
    "turbo": "2.5.4",
    "typescript": "5.9.2"
  },
  "packageManager": "yarn@4.17.0",
  "engines": {
    "node": ">=20"
  }
}
