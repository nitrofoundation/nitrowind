{
  "name": "nitrowind-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Nitrowind — fully open-source, fastest Tailwind bindings for React Native (native C++ ShadowTree engine, free for everyone)",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "example"
  ],
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "nitrogen": "turbo run nitrogen",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "2.5.4",
    "typescript": "5.9.2"
  },
  "packageManager": "yarn@4.17.0",
  "engines": {
    "node": ">=20"
  }
}
